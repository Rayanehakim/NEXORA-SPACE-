{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "definitionsVersion", "regions"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "analysis-plan-v1"},
    "definitionsVersion": {"const": "terrain-descriptors-v1"},
    "regions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/region"}}
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["regionId", "body", "bounds", "crs", "horizontalUnit", "footprintWidthM", "footprintHeightM", "roughnessWindowM"],
      "additionalProperties": false,
      "properties": {
        "regionId": {"type": "string", "minLength": 1},
        "body": {"enum": ["earth", "mars", "moon"]},
        "crs": {"type": "string", "minLength": 1},
        "horizontalUnit": {"const": "m"},
        "footprintWidthM": {"type": "number", "exclusiveMinimum": 0},
        "footprintHeightM": {"type": "number", "exclusiveMinimum": 0},
        "roughnessWindowM": {"type": "number", "exclusiveMinimum": 0},
        "bounds": {
          "type": "object", "required": ["west", "south", "east", "north"], "additionalProperties": false,
          "properties": {
            "west": {"type": "number", "minimum": -180, "maximum": 180},
            "east": {"type": "number", "minimum": -180, "maximum": 180},
            "south": {"type": "number", "minimum": -90, "maximum": 90},
            "north": {"type": "number", "minimum": -90, "maximum": 90}
          }
        }
      }
    }
  }
}
