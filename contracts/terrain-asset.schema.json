{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terrain Asset",
  "type": "object",
  "required": [
    "earthSiteId",
    "version",
    "sourceType",
    "width",
    "height",
    "cellSizeM",
    "elevationM",
    "provenanceSourceId"
  ],
  "properties": {
    "earthSiteId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sourceType": {
      "enum": [
        "PROCEDURAL",
        "DEM_DERIVED"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 2
    },
    "height": {
      "type": "integer",
      "minimum": 2
    },
    "cellSizeM": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "elevationM": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "provenanceSourceId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
